import { NextResponse } from "next/server";
import { auth } from "@/auth";
import { db } from "@/lib/db";
import { AuthorizationError, requirePermission } from "@/lib/auth/authorization";
import { ensureSystemRbac } from "@/lib/auth/rbac";
import { ensureVetMedRolesAndPermissions, VETMED_ROLES } from "@/lib/auth/vetmed-roles";
import { hashPassword } from "@/lib/auth/password";

type RoleName = typeof VETMED_ROLES[number];

function text(v: unknown) {
  return typeof v === "string" ? v.trim() : "";
}

export async function GET() {
  try {
    await ensureSystemRbac();
    await ensureVetMedRolesAndPermissions();
    const a = await requirePermission("users.read");

    const memberships = await db.orm.public.ClinicMembership.where({
      clinic_id: a.clinicId,
      is_active: true,
    }).all();

    const rows = [];

    for (const membership of memberships) {
      const user = await db.orm.public.User.first({ id: membership.user_id });
      const role = await db.orm.public.Role.first({ id: membership.role_id });

      if (user) {
        rows.push({
          id: user.id,
          name: user.name,
          email: user.email,
          is_active: user.is_active,
          role: role?.name ?? "",
          membership_id: membership.id,
        });
      }
    }

    return NextResponse.json({ ok: true, data: rows });
  } catch (e) {
    if (e instanceof AuthorizationError) {
      return NextResponse.json({ ok: false, error: e.message }, { status: 403 });
    }

    console.error(e);
    return NextResponse.json({ ok: false, error: "Internal server error" }, { status: 500 });
  }
}

export async function POST(request: Request) {
  try {
    await ensureSystemRbac();
    await ensureVetMedRolesAndPermissions();
    const a = await requirePermission("users.manage");

    const b = await request.json();
    const name = text(b?.name);
    const email = text(b?.email).toLowerCase();
    const password = typeof b?.password === "string" ? b.password : "";
    const requestedRole = VETMED_ROLES.includes(b?.role as RoleName)
      ? (b.role as RoleName)
      : "VETERINARIAN";

    if (
      name.length < 2 ||
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ||
      password.length < 12
    ) {
      return NextResponse.json(
        {
          ok: false,
          error: "Ad, geçerli e-posta ve en az 12 karakterlik şifre zorunludur.",
        },
        { status: 400 },
      );
    }

    if (await db.orm.public.User.first({ email })) {
      return NextResponse.json(
        { ok: false, error: "Bu e-posta zaten kayıtlı." },
        { status: 409 },
      );
    }

    const role = await db.orm.public.Role.first({ name: requestedRole });
    if (!role) throw new Error("Role missing");

    const user = await db.orm.public.User.create({
      name,
      email,
      password_hash: await hashPassword(password),
    });

    await db.orm.public.ClinicMembership.create({
      user_id: user.id,
      clinic_id: a.clinicId,
      role_id: role.id,
    });

    return NextResponse.json(
      {
        ok: true,
        data: {
          id: user.id,
          name: user.name,
          email: user.email,
          role: requestedRole,
        },
      },
      { status: 201 },
    );
  } catch (e) {
    if (e instanceof AuthorizationError) {
      return NextResponse.json({ ok: false, error: e.message }, { status: 403 });
    }

    console.error(e);
    return NextResponse.json({ ok: false, error: "Internal server error" }, { status: 500 });
  }
}

export async function PATCH(request: Request) {
  try {
    await ensureSystemRbac();
    await ensureVetMedRolesAndPermissions();
    const a = await requirePermission("users.manage");

    const b = await request.json();
    const userId = text(b?.userId);
    const roleName = VETMED_ROLES.includes(b?.role as RoleName)
      ? (b.role as RoleName)
      : null;

    if (!userId) {
      return NextResponse.json(
        { ok: false, error: "userId zorunludur." },
        { status: 400 },
      );
    }

    const membership = await db.orm.public.ClinicMembership.first({
      user_id: userId,
      clinic_id: a.clinicId,
    });

    if (!membership) {
      return NextResponse.json(
        { ok: false, error: "Kullanıcı bu klinikte değil." },
        { status: 404 },
      );
    }

    if (roleName) {
      const role = await db.orm.public.Role.first({ name: roleName });
      if (!role) throw new Error("Role missing");

      await db.orm.public.ClinicMembership.where({ id: membership.id }).update({
        role_id: role.id,
      });
    }

    if (typeof b?.isActive === "boolean") {
      await db.orm.public.User.where({ id: userId }).update({
        is_active: b.isActive,
        security_stamp: crypto.randomUUID(),
      });
    }

    return NextResponse.json({ ok: true });
  } catch (e) {
    if (e instanceof AuthorizationError) {
      return NextResponse.json({ ok: false, error: e.message }, { status: 403 });
    }

    console.error(e);
    return NextResponse.json({ ok: false, error: "Internal server error" }, { status: 500 });
  }
}