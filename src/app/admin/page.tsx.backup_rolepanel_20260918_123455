import { redirect } from "next/navigation";
import Link from "next/link";
import { auth } from "@/auth";
import { requirePermission, AuthorizationError } from "@/lib/auth/authorization";
import AdminUsers from "./users";

export default async function AdminPage() {
  const session = await auth();
  if (!session?.user?.id) redirect("/login");
  try { await requirePermission("users.read"); }
  catch (e) { if (e instanceof AuthorizationError) redirect("/dashboard"); throw e; }

  return (
    <main className="min-h-screen bg-slate-950 px-4 py-8 text-white">
      <div className="mx-auto max-w-7xl">
        <div className="flex flex-col gap-4 rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur md:flex-row md:items-center md:justify-between">
          <div><p className="text-xs font-bold uppercase tracking-[.25em] text-teal-300">VetMed Admin</p><h1 className="mt-2 text-3xl font-black">Kullanıcı ve Yetki Yönetimi</h1><p className="mt-2 text-sm text-slate-300">Kullanıcı oluşturma, rol atama ve hesap durumları.</p></div>
          <Link href="/dashboard" className="rounded-2xl border border-white/15 px-4 py-3 text-sm font-bold hover:bg-white/10">Dashboard</Link>
        </div>
        <div className="mt-6 grid gap-6 lg:grid-cols-[1.3fr_.7fr]">
          <section className="rounded-3xl bg-white p-6 text-slate-900 shadow-2xl"><h2 className="text-xl font-black">Kullanıcılar</h2><AdminUsers /></section>
          <section className="rounded-3xl bg-gradient-to-br from-teal-700 to-slate-900 p-6 shadow-2xl">
            <h2 className="text-xl font-black">Roller</h2>
            <div className="mt-5 space-y-3 text-sm">
              <div className="rounded-2xl bg-white/10 p-4"><b>ADMIN</b><br/><span className="text-slate-300">Sistem ve kullanıcı yönetimi</span></div>
              <div className="rounded-2xl bg-white/10 p-4"><b>VETERINARIAN</b><br/><span className="text-slate-300">Klinik değerlendirme ve tanı</span></div>
              <div className="rounded-2xl bg-white/10 p-4"><b>VETERINARY_DATA_ENTRY</b><br/><span className="text-slate-300">Klinik veri girişi</span></div>
              <div className="rounded-2xl bg-white/10 p-4"><b>VETERINARY_STUDENT</b><br/><span className="text-slate-300">Öğrenme ve karar destek erişimi</span></div>
            </div>
          </section>
        </div>
      </div>
    </main>
  );
}