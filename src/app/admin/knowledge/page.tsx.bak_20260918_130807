"use client";

import { useEffect, useState } from "react";
import Link from "next/link";

type RecordRow = {
  id: string;
  diagnosis_name: string;
  species: string;
  review_status: string;
  source_type: string;
  created_at: string;
};

export default function AdminKnowledgePage() {
  const [rows, setRows] = useState<RecordRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  async function load() {
    setLoading(true);
    try {
      const response = await fetch("/api/admin/knowledge?status=PENDING", {
        cache: "no-store",
      });
      const data = await response.json();

      if (!response.ok) {
        setError(data.error || "Bilgi havuzu alınamadı.");
        return;
      }

      setRows(data.records || data.knowledge || []);
    } catch {
      setError("Bilgi havuzu alınamadı.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();
  }, []);

  return (
    <main className="min-h-screen bg-slate-50">
      <div className="mx-auto max-w-6xl px-6 py-8">
        <Link href="/admin" className="text-sm font-semibold text-sky-700">
          ← Yönetici paneli
        </Link>

        <div className="mt-5 rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
          <h1 className="text-2xl font-semibold text-slate-900">
            Klinik Bilgi Havuzu
          </h1>
          <p className="mt-2 text-sm text-slate-500">
            Klinik vakalardan gelen kayıtları doğrulama kuyruğu.
          </p>

          {error ? (
            <div className="mt-6 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
              {error}
            </div>
          ) : null}

          {loading ? (
            <p className="mt-6 text-sm text-slate-500">Yükleniyor…</p>
          ) : rows.length === 0 ? (
            <div className="mt-6 rounded-2xl bg-slate-50 p-5 text-sm text-slate-600">
              Bekleyen bilgi kaydı bulunmuyor.
            </div>
          ) : (
            <div className="mt-6 space-y-3">
              {rows.map((row) => (
                <div
                  key={row.id}
                  className="rounded-2xl border border-slate-200 p-5"
                >
                  <div className="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                    <div>
                      <h2 className="font-semibold text-slate-900">
                        {row.diagnosis_name}
                      </h2>
                      <p className="mt-1 text-sm text-slate-500">
                        Tür: {row.species || "UNKNOWN"} · Kaynak: {row.source_type}
                      </p>
                    </div>
                    <span className="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
                      {row.review_status}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </main>
  );
}